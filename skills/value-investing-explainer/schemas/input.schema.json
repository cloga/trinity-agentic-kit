{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Value Investing Explainer Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_id", "title", "concept", "audience", "objective", "evidence", "claims"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "concept": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "source_type", "as_of_date", "content_summary", "content_kind"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "as_of_date": { "type": "string", "format": "date" },
          "content_summary": { "type": "string", "minLength": 1 },
          "content_kind": { "enum": ["paraphrase", "facts", "public_domain_like", "audit_output"] },
          "uri": { "type": "string" },
          "provenance_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "source_ids"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}

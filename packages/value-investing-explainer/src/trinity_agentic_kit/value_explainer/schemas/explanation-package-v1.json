{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Value Investing Explanation Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "topic_id", "title", "summary", "key_points", "caveats", "scenes", "evidence", "qa", "provider_name", "disclaimer"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "package_version": { "type": "string", "minLength": 1 },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "$ref": "#/$defs/claim" },
    "key_points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "caveats": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "narration", "visual_direction", "source_ids"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "narration": { "type": "string", "minLength": 1 },
          "visual_direction": { "type": "string", "minLength": 1 },
          "source_ids": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks", "issues"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "passed", "message"],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "issues": { "$ref": "#/$defs/stringArray" }
      }
    },
    "provider_name": { "type": "string", "minLength": 1 },
    "disclaimer": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "source_type", "as_of_date", "content_summary", "content_kind", "uri", "provenance_ids"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "as_of_date": { "type": "string", "format": "date" },
        "content_summary": { "type": "string", "minLength": 1 },
        "content_kind": { "enum": ["paraphrase", "facts", "public_domain_like", "audit_output"] },
        "uri": { "type": "string" },
        "provenance_ids": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
